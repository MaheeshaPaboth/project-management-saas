# ==============================================================================
# Environment Configuration Template
# Copy this file to .env before starting the application:
#   Copy-Item .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=company_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/company_management
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_this_password

# Redis Configuration
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Backend Server Configuration
SERVER_PORT=8080
PORT=8080

# Frontend Configuration
VITE_API_URL=http://localhost:8080
